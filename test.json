{
  "language": "cpp",
  "filename": "main.cpp",
  "version": "1.0",
  "code": "import java.io.*;

public class Main {
    static void test(String url) {
        try {
            Process p = new ProcessBuilder(
                "curl", "-sL", "-o", "/dev/null",
                "-w", "%{http_code}",
                "--max-time", "5",
                url
            ).start();

            String result = new String(
                p.getInputStream().readAllBytes()
            ).trim();

            String error = new String(
                p.getErrorStream().readAllBytes()
            ).trim();

            int exit = p.waitFor();

            System.out.println(
                url + " -> exit=" + exit +
                ", HTTP=" + result +
                (error.isEmpty() ? "" : ", error=" + error)
            );

        } catch (Exception e) {
            System.out.println(url + " -> " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        test("https://cheenu-exe.github.io/cpp/test.json");
    }
}"
}
